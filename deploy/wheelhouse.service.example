# Example rootless-Podman systemd user unit for Wheelhouse. Adjust the paths,
# then install to ~/.config/systemd/user/container-wheelhouse.service and run:
#   systemctl --user daemon-reload
#   systemctl --user enable --now container-wheelhouse.service
# (and `loginctl enable-linger $USER` so it starts at boot without a login).
#
# Pull the image first, so the first start doesn't have to download it:
#   podman pull docker.io/tristanwl/wheelhouse:0.1.1
# To upgrade, change the version tag on the last ExecStart line below, then
# `systemctl --user daemon-reload && systemctl --user restart
# container-wheelhouse.service`. (There is no `latest` tag while Wheelhouse is
# alpha.) To build from source instead:
#   podman build -t wheelhouse:dev .
# and use localhost/wheelhouse:dev as the image.
#
# /movies and /tv must be the same in-container paths Sonarr/Radarr use; they
# are only needed for the Codecs "Convert" feature.
#
# The image runs as a non-root user. With rootless Podman, --userns=keep-id
# --user=%U:%G maps the container user to YOUR host user, so it can read and
# write your host-owned /config and media. Without it the container's user
# maps to an unrelated sub-UID and cannot write to them. Tested together with
# --group-add keep-groups below on Podman 4.9 / crun 1.14 (Intel VAAPI).
#
# --device /dev/dri passes the GPU render node through for hardware encode.
# Rootless Podman can't grant access the host user doesn't already have, so
# your user must be in the host's `render`/`video` groups.
# --group-add keep-groups is required alongside it: rootless Podman does NOT
# propagate the host user's supplementary groups into the container by
# default, so without it VAAPI can't open the device. Remove both lines if you
# don't want hardware encoding.

[Unit]
Description=Podman container-wheelhouse.service
Documentation=man:podman-generate-systemd(1)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=always
TimeoutStopSec=70
ExecStart=/usr/bin/podman run \
	--cidfile=%t/%n.ctr-id \
	--cgroups=no-conmon \
	--rm \
	--sdnotify=conmon \
	-d \
	--name=wheelhouse \
	--network=host \
	--userns=keep-id \
	--user=%U:%G \
	--env-file=%h/wheelhouse/.env \
	-v /path/to/movies:/movies \
	-v /path/to/tv:/tv \
	-v %h/wheelhouse/config:/config \
	--device /dev/dri \
	--group-add keep-groups \
	--replace docker.io/tristanwl/wheelhouse:0.1.1
ExecStop=/usr/bin/podman stop \
	--ignore -t 10 \
	--cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm \
	-f \
	--ignore -t 10 \
	--cidfile=%t/%n.ctr-id
Type=notify
NotifyAccess=all

[Install]
WantedBy=default.target
