# Every service is optional; one that isn't set is reported as not
# configured. Sonarr/Radarr power the Library, Explore and Codecs pages.
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# More than one Radarr or Sonarr: RADARR_<ID>_URL and RADARR_<ID>_API_KEY.
# RADARR_4K_* becomes the instance "radarr-4k", shown as "Radarr 4K".
# RADARR_4K_URL=http://localhost:7879
# RADARR_4K_API_KEY=

SABNZBD_URL=http://localhost:8080
SABNZBD_API_KEY=

# Optional: status card degrades gracefully if these are unset (PLEX_URL
# missing) or if the server isn't claimed/tokened yet (PLEX_TOKEN missing).
PLEX_URL=http://localhost:32400
PLEX_TOKEN=

# Optional: powers /explore. Free key from themoviedb.org (account settings
# -> API). App works fine without it, /explore just shows "not configured".
TMDB_API_KEY=
